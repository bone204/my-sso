# ==============================================================================
# PaSSO Keycloak 26 - Configuration with Supabase PostgreSQL
# ==============================================================================

# Database Engine
KC_DB=postgres

# ------------------------------------------------------------------------------
# SUPABASE CONNECTION CONFIGURATION:
# Retrieve your credentials at: Supabase Dashboard -> Project Settings -> Database
# ------------------------------------------------------------------------------

# Option 1: Direct Connection (Port 5432)
# Recommended if your network supports IPv6 or with Supabase IPv4 Addon
KC_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Option 2: Session Pooler (Port 5432, IPv4 compatible)
# IMPORTANT: Use port 5432 (Session mode). DO NOT use port 6543 (Transaction mode)
# because Keycloak migrations require PostgreSQL session-level advisory locks.
# KC_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# KC_DB_USERNAME=postgres.YOUR_PROJECT_REF
# KC_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Keycloak Bootstrap Admin Credentials (Keycloak 26)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
