# ==============================================================================
# PaSSO Keycloak 26 - Configuration Environment
# ==============================================================================

# Database Engine
KC_DB=postgres

# ------------------------------------------------------------------------------
# OPTION 1: LOCAL POSTGRESQL (Active Default - Fast & Stable for Codespaces)
# Starts automatically with Docker Compose, instant startup, no network timeout
# ------------------------------------------------------------------------------
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=password

# ------------------------------------------------------------------------------
# OPTION 2: SUPABASE POSTGRESQL (Session Pooler - Port 5432)
# To use Supabase, comment out Option 1 above and uncomment these 3 lines:
# ------------------------------------------------------------------------------
# KC_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# KC_DB_USERNAME=postgres.YOUR_PROJECT_REF
# KC_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Keycloak Bootstrap Admin Credentials (Keycloak 26)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
